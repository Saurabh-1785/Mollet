# ---------------------------------------------------------------------------
# Mollet configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Otari gateway (US). EU accounts: https://eu.api.otari.ai/api/v1
OTARI_BASE_URL=https://api.otari.ai/api/v1
# A SERVICE key: API keys -> Create key -> Advanced -> tick "Service key",
# pick the end-user budget(s) and a default. Starts with otk_
OTARI_API_KEY=

# --- Models (all open-weight). Use routing policy names once created. --------
# Rungs 1-3. Routing policy "mollet-hinter": "Add a fallback chain" (model A -> B)
MOLLET_HINTER_MODEL=mollet-hinter
# Rungs 4-5. Routing policy "mollet-mentor": "Tier down when the budget fills up"
MOLLET_MENTOR_MODEL=mollet-mentor
# Grader: a different open-weight CODING model (a plain model id is fine)
MOLLET_GRADER_MODEL=mollet-grader

# --- Tools -----------------------------------------------------------------
# Id of the classroom MCP server after registering <public-url>/classroom/mcp
# under Tools -> MCP servers. Empty = MCP off (history is inlined instead).
MOLLET_MCP_SERVER_ID=
# Shared secret for the MCP endpoint; set the same token on the workspace MCP server.
MOLLET_MCP_TOKEN=
# Optional: lock the MCP endpoint to your public host(s), comma-separated.
MOLLET_MCP_ALLOWED_HOSTS=
MOLLET_WEB_SEARCH=true
MOLLET_GRADER_CODE_TOOL=true
MOLLET_CODE_TIMEOUT_S=10

# --- Guardrails ------------------------------------------------------------
# Request-level profiles sent in block mode (comma-separated), on top of the
# organization-mandated guardrails. See GET /api/v1/tool-settings/guardrails/profiles
MOLLET_GUARDRAILS=
# App rule (not Otari): local regex PII pre-check. Keep false for the demo so
# the Otari guardrail is what blocks.
MOLLET_APP_PII_PRECHECK=false

# --- Display only (the real caps live in Otari) ------------------------------
MOLLET_WALLET_USD=0.05
# Match this to the weekly workspace budget you set in the dashboard.
MOLLET_CLASS_BUDGET_USD=1.00

# --- Dev only ----------------------------------------------------------------
# Offline fake gateway for UI work. NEVER record the demo with this on.
MOLLET_MOCK=false
